<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="brigx-cargo-lock-sha256" content="__CARGO_LOCK_SHA256__">
  <title>BRIGX Rust third-party licences</title>
  <style>
    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
    body { margin: 2rem auto; max-width: 70rem; padding: 0 1rem; line-height: 1.5; }
    a { color: #0f766e; }
    pre { border: 1px solid #8886; border-radius: .4rem; max-height: 24rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
    .licence { border-top: 1px solid #8886; margin-top: 2rem; padding-top: 1rem; }
  </style>
</head>
<body>
  <main>
    <h1>BRIGX Rust third-party licences</h1>
    <p>This file lists the Rust libraries linked into the BRIGX Tauri desktop application. It was generated from the locked production dependency graph with cargo-about.</p>
    <h2>Licence overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    <h2>Licence texts</h2>
    {{#each licenses}}
    <section class="licence">
      <h3 id="{{id}}">{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
