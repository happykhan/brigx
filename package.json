{
    "name": "brig-web",
    "productName": "BRIGX",
    "version": "0.6.30",
    "description": "Browser-based circular genome comparison tool — BLAST Ring Image Generator in the browser",
    "private": true,
    "type": "module",
    "main": "desktop-dist/main.cjs",
    "engines": {
        "node": ">=24 <25"
    },
    "license": "GPL-3.0",
    "author": "Nabil-Fareed Alikhan",
    "homepage": "https://brigx.genomicx.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/happykhan/BRIGx.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "start": "vite preview",
        "lint": "eslint .",
        "quality:architecture": "bash scripts/check-architecture.sh",
        "quality:licenses": "node scripts/check-licenses.mjs",
        "quality:security": "node scripts/check-security.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "desktop:runtime": "node scripts/prepare-electron-runtime.mjs",
        "desktop:build:main": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=desktop-dist --out-extension:.js=.cjs --sourcemap --target=node24",
        "desktop:build": "npm run desktop:runtime && npm run build && npm run desktop:build:main",
        "desktop:dev": "node scripts/desktop-dev.mjs",
        "desktop:start": "npm run desktop:build && electron .",
        "desktop:test": "npm run desktop:build && playwright test --config=playwright.electron.config.ts",
        "desktop:package": "npm run desktop:build && electron-forge package",
        "desktop:make": "npm run desktop:build && electron-forge make",
        "verify": "npm run lint && npm run quality:architecture && npm run quality:licenses && npm run quality:security && npm test && npm run build && npm run test:e2e",
        "verify:desktop": "npm run desktop:test && npm run desktop:package",
        "verify:all": "npm run verify && npm run verify:desktop"
    },
    "dependencies": {
        "@genomicx/ui": "0.9.1",
        "pako": "2.2.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hot-toast": "2.6.0",
        "react-router-dom": "7.18.2"
    },
    "devDependencies": {
        "@electron-forge/cli": "7.11.2",
        "@electron-forge/maker-deb": "7.11.2",
        "@electron-forge/maker-dmg": "7.11.2",
        "@electron-forge/maker-rpm": "7.11.2",
        "@electron-forge/maker-squirrel": "7.11.2",
        "@electron-forge/maker-zip": "7.11.2",
        "@electron-forge/plugin-fuses": "7.11.2",
        "@electron/fuses": "2.1.3",
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.62.1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "6.9.1",
        "@types/node": "24.13.3",
        "@types/pako": "2.0.4",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "4.7.0",
        "@vitest/coverage-v8": "3.2.7",
        "electron": "43.2.0",
        "esbuild": "0.28.1",
        "eslint": "9.39.5",
        "jsdom": "26.1.0",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.65.0",
        "vite": "6.4.3",
        "vitest": "3.2.7"
    },
    "overrides": {
        "dompurify": "3.4.12",
        "tar": "7.5.22",
        "tmp": "0.2.7"
    },
    "allowScripts": {
        "electron-winstaller@5.4.4": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.1": true,
        "fs-xattr@0.3.1": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "macos-alias@0.2.12": true
    }
}
