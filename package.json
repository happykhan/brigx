{
    "name": "brig-web",
    "version": "0.6.11",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "start": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "deploy": "npm run build:check && git add -A && git commit -m 'Deploy: build verified' && git push",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@genomicx/ui": "^0.1.0",
        "@handsontable/react": "^16.2.0",
        "comlink": "^4.4.1",
        "handsontable": "^16.2.0",
        "idb": "^8.0.0",
        "pako": "^2.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.6.0",
        "react-router-dom": "^7.5.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/node": "^22",
        "@types/pako": "^2.0.4",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react": "^4.4.1",
        "@vitest/coverage-v8": "^3.1.1",
        "autoprefixer": "^10.4.17",
        "eslint": "^9.39.4",
        "jsdom": "^26.1.0",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "typescript-eslint": "^8.57.2",
        "vite": "^6.3.0",
        "vitest": "^3.1.1"
    }
}
