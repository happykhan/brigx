{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BRIGX",
  "version": "../package.json",
  "identifier": "org.genomicx.brigx",
  "mainBinaryName": "BRIGX",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:5173",
        "script-src": "'self' http://127.0.0.1:5173 blob: 'unsafe-eval' 'wasm-unsafe-eval'",
        "worker-src": "'self' http://127.0.0.1:5173 blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173",
        "img-src": "'self' http://127.0.0.1:5173 blob: data:",
        "style-src": "'self' http://127.0.0.1:5173 'unsafe-inline'",
        "font-src": "'self' http://127.0.0.1:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "headers": {
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "copyright": "Copyright © 2026 Nabil-Fareed Alikhan",
    "shortDescription": "Offline circular comparative genome visualisation",
    "longDescription": "BRIGX creates interactive circular whole-genome comparison plots using a local BLAST WebAssembly engine.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    },
    "icon": [
      "../desktop/assets/icon.png",
      "../desktop/assets/icon.icns",
      "../desktop/assets/icon.ico"
    ]
  }
}
