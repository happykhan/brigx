{
  "name": "brig-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:check": "next build && echo '\n✅ Build successful! Safe to push to Vercel.'",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "deploy": "npm run build:check && git add -A && git commit -m 'Deploy: build verified' && git push"
  },
  "dependencies": {
    "@biowasm/aioli": "^3.2.1",
    "@handsontable/react": "^16.2.0",
    "comlink": "^4.4.1",
    "handsontable": "^16.2.0",
    "idb": "^8.0.0",
    "next": "^15.5.9",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5",
    "typescript-eslint": "^8.57.2"
  }
}
